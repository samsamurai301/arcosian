# Lanes: ios beta | ios metadata | ios release | android internal | android metadata | android promote
# Auth: App Store Connect Team API key via env (ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_CONTENT).
# Never auto-submits for review; `release` needs an explicit env confirmation from a human.

default_platform(:ios)

def asc_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_CONTENT"),
    is_key_content_base64: ENV["ASC_KEY_IS_BASE64"] == "1",
    in_house: false
  )
end

platform :ios do
  desc "Signed build from the exported Xcode project, uploaded to TestFlight (no review submission)"
  lane :beta do
    key = asc_key
    setup_ci if ENV["CI"]
    match(type: "appstore", readonly: true, api_key: key)
    build_number = (latest_testflight_build_number(api_key: key) rescue 0).to_i + 1
    increment_build_number(build_number: build_number, xcodeproj: ENV.fetch("XCODEPROJ_PATH"))
    gym(
      project: ENV.fetch("XCODEPROJ_PATH"),
      scheme: ENV.fetch("XCODE_SCHEME", File.basename(ENV.fetch("XCODEPROJ_PATH"), ".xcodeproj")),
      export_method: "app-store",
      output_directory: "build/ipa",
      clean: true
    )
    pilot(
      api_key: key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      submit_beta_review: false
    )
  end

  desc "Upload metadata and screenshots only (no binary, no submission)"
  lane :metadata do
    deliver(
      api_key: asc_key,
      skip_binary_upload: true,
      skip_screenshots: ENV["SKIP_SCREENSHOTS"] == "1",
      submit_for_review: false,
      force: true
    )
  end

  desc "Submit a processed build for App Store review. Guarded: requires CONFIRM_RELEASE=yes-i-approve"
  lane :release do
    UI.user_error!("Refusing to release: set CONFIRM_RELEASE=yes-i-approve after human sign-off") unless ENV["CONFIRM_RELEASE"] == "yes-i-approve"
    deliver(
      api_key: asc_key,
      skip_binary_upload: true,
      submit_for_review: true,
      automatic_release: false,
      force: true
    )
  end
end

platform :android do
  desc "Upload the AAB to the internal testing track"
  lane :internal do
    supply(
      track: "internal",
      aab: ENV.fetch("AAB_PATH"),
      release_status: "draft",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload Play listing text and images only"
  lane :metadata do
    supply(skip_upload_aab: true, skip_upload_apk: true)
  end

  desc "Promote internal to another track. Guarded: requires CONFIRM_RELEASE=yes-i-approve"
  lane :promote do
    UI.user_error!("Refusing to promote: set CONFIRM_RELEASE=yes-i-approve after human sign-off") unless ENV["CONFIRM_RELEASE"] == "yes-i-approve"
    supply(
      track: "internal",
      track_promote_to: ENV.fetch("PROMOTE_TO", "beta"),
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
