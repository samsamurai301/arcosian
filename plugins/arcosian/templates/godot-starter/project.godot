; Engine configuration file. Edited by hand for the template; Godot rewrites it on save.
; Input: every move works by swipe/drag, keyboard (arrows, WASD) and gamepad (D-pad, left stick).
; WASD uses physical keys (same place on AZERTY); arrows, Esc and F11 use logical keys.
config_version=5

[application]

config/name="Merge Five"
config/description="arcosian reference template: deterministic sim-core + presentation."
run/main_scene="res://presentation/boot.tscn"
config/features=PackedStringArray("4.5", "Mobile")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

EventBus="*res://services/event_bus.gd"
SaveService="*res://services/save_service.gd"
AudioService="*res://services/audio_service.gd"
Haptics="*res://services/haptics.gd"
Analytics="*res://services/analytics.gd"
Ads="*res://services/ads.gd"
Iap="*res://services/iap.gd"
AppLifecycle="*res://services/app_lifecycle.gd"
SafeArea="*res://services/safe_area.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input]

move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65)
, Object(InputEventKey,"device":-1,"keycode":4194319)
, Object(InputEventJoypadButton,"device":-1,"button_index":13)
, Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0)]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68)
, Object(InputEventKey,"device":-1,"keycode":4194321)
, Object(InputEventJoypadButton,"device":-1,"button_index":14)
, Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0)]
}
move_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87)
, Object(InputEventKey,"device":-1,"keycode":4194320)
, Object(InputEventJoypadButton,"device":-1,"button_index":11)
, Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1.0)]
}
move_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83)
, Object(InputEventKey,"device":-1,"keycode":4194322)
, Object(InputEventJoypadButton,"device":-1,"button_index":12)
, Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0)]
}
pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"keycode":4194305)
, Object(InputEventJoypadButton,"device":-1,"button_index":6)]
}
toggle_fullscreen={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"keycode":4194342)
, Object(InputEventKey,"device":-1,"alt_pressed":true,"physical_keycode":4194309)]
}

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
